# Copiez ce fichier en .env et remplissez les valeurs

# Secret JWT — doit faire au moins 32 caractères, généré aléatoirement
JWT_SECRET=votre_secret_jwt_tres_long_et_aleatoire_min_32_chars

# Mot de passe PostgreSQL (utilisé par le service docker-compose)
POSTGRES_PASSWORD=votre_mot_de_passe_postgres
